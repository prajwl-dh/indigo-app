{
    "name": "indigo",
    "version": "1.0.1",
    "description": "A modern, lightweight notes application designed for flexibility, organization, and a pleasant writing experience",
    "main": "./out/main/index.js",
    "type": "module",
    "author": "prajwalonline.com",
    "homepage": "https://github.com/prajwl-dh/indigo-app",
    "scripts": {
        "clean": "rimraf dist && rimraf out",
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "npm run clean && electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run clean && npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "resolve-libsql": "node resolveIntelMacLibsql.js",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run clean && npm run build && electron-builder --win",
        "build:mac-intel": "npm run clean && npm run resolve-libsql && electron-vite build && electron-builder --mac --x64",
        "build:mac-arm": "npm run clean && electron-vite build && electron-builder --mac --arm64",
        "build:mac-universal": "npm run clean && npm run resolve-libsql && electron-vite build && electron-builder --mac --universal",
        "build:linux": "npm run clean && electron-vite build && electron-builder --linux"
    },
    "dependencies": {
        "@blocknote/code-block": "^0.54.0",
        "@blocknote/mantine": "^0.54.0",
        "@blocknote/react": "^0.54.0",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@headlessui/react": "^2.2.10",
        "@libsql/client": "^0.17.4",
        "drizzle-orm": "^0.45.2",
        "electron-context-menu": "^4.1.2",
        "electron-store": "^11.0.2",
        "javascript-time-ago": "^2.6.4",
        "lodash": "^4.18.1",
        "lucide-react": "^1.33.0",
        "react-textarea-autosize": "^8.5.9",
        "react-time-ago": "^7.4.4",
        "react-use-draggable-scroll": "^0.4.7",
        "remove-markdown": "^0.6.4",
        "shiki": "^4.4.3",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.1.4",
        "autoprefixer": "^10.5.4",
        "electron": "^43.4.1",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^9.39.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rimraf": "^6.1.3",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "optionalDependencies": {
        "@libsql/darwin-arm64": "^0.5.29",
        "@libsql/darwin-x64": "^0.5.29"
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "electron@43.4.1": true
    }
}
