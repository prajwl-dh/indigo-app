{
    "name": "indigo",
    "version": "1.0.4",
    "description": "A quiet, local-first notes workspace with a block editor, tags, and a paper-and-ink shell",
    "main": "./out/main/index.js",
    "type": "module",
    "author": "prajwalonline.com",
    "homepage": "https://github.com/prajwl-dh/indigo-app",
    "scripts": {
        "clean": "rimraf dist && rimraf out",
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "test": "vitest run",
        "test:watch": "vitest",
        "start": "npm run clean && electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run clean && npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win --publish never",
        "build:mac-intel": "npm run build && electron-builder --mac --x64 --publish never",
        "build:mac-arm": "npm run build && electron-builder --mac --arm64 --publish never",
        "build:mac-universal": "npm run build && electron-builder --mac --universal --publish never",
        "build:linux": "npm run build && electron-builder --linux --publish never",
        "release": "node manageRelease.js release",
        "delete-current-release": "node manageRelease.js delete"
    },
    "dependencies": {
        "@blocknote/code-block": "^0.54.0",
        "@blocknote/core": "^0.54.0",
        "@blocknote/mantine": "^0.54.0",
        "@blocknote/react": "^0.54.0",
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@headlessui/react": "^2.2.10",
        "electron-context-menu": "^5.1.0",
        "electron-store": "^12.0.0",
        "lucide-react": "^1.61.0",
        "react-textarea-autosize": "^8.5.9"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-prettier": "^3.0.1",
        "@electron-toolkit/eslint-config-ts": "^3.1.0",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^45.0.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^6.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "prettier": "^3.9.10",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rimraf": "^6.1.3",
        "typescript": "~5.9.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "allowScripts": {
        "electron-winstaller@5.4.0": true,
        "esbuild@0.25.12": true,
        "esbuild@0.28.2": true,
        "electron@43.4.1": true,
        "fsevents@2.3.3": true
    }
}
